{
  "name": "@frontline/plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Inbox, channels, tickets and customer messaging for erxes",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @frontline/api build && pnpm --filter @frontline/ui build && pnpm --filter @frontline/widget build",
    "budgets": "node tools/budgets.ts",
    "db:generate": "pnpm --filter @frontline/api db:generate",
    "db:check": "pnpm --filter @frontline/api db:check",
    "db:migrate": "pnpm --filter @frontline/api db:migrate",
    "check:generated": "node tools/check-generated.ts",
    "check:rls": "bash tools/check-rls.sh",
    "dev:api": "pnpm --filter @frontline/api dev",
    "dev:ui": "pnpm --filter @frontline/ui dev",
    "dev:widget": "pnpm --filter @frontline/widget dev",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:stack": "bash e2e/stack.sh",
    "image": "pnpm build && rm -rf .runtime && pnpm --filter @frontline/api deploy --prod .runtime && docker build --build-arg VERSION=${VERSION:-dev} -t frontline-plugin:ci .",
    "migrate:import": "node --env-file-if-exists=.env scripts/import-mongo.ts",
    "check:migration": "vp test run api/src/__tests__/migration.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@erxes/core-contract": "0.1.0-v2.52",
    "@erxes/lint": "0.1.3",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/openapi-client": "1.16.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "knip": "^6.45.1",
    "mongodb": "^7.8.0",
    "pg": "^8.23.1",
    "react-doctor": "0.9.23",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0"
}
