{
  "name": "@frontline/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "drizzle",
    "src"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/router.ts",
    "./files": "./src/modules/files.ts",
    "./forms": "./src/modules/forms/embed.ts",
    "./helpcenter": "./src/modules/helpcenter/public.ts",
    "./logic": "./src/modules/forms/logic.ts",
    "./messenger": "./src/modules/messenger/routes.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import ./src/telemetry.ts --watch-path=src src/main.ts",
    "build": "vp pack src/main.ts src/telemetry.ts --format esm --sourcemap --no-dts",
    "start": "node --enable-source-maps --import ./dist/telemetry.mjs dist/main.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../.env src/migrate.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/ws": "^2.0.4",
    "@erxes/core-contract": "0.1.0-v2.29",
    "@erxes/plugin-sdk": "0.1.0-v2.28",
    "@noble/ciphers": "^2.4.0",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "cloudflare": "^7.3.0",
    "cors": "^2.8.6",
    "discord-api-types": "^0.38.59",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "express": "^5.3.0",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "imapflow": "^2.11.0",
    "import-in-the-middle": "^3.6.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.17",
    "linkifyjs": "^4.4.0",
    "lru-cache": "^11.5.3",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "re2js": "^2.10.0",
    "sanitize-html": "^2.18.2",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "0.31.11"
  }
}
