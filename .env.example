# The API reads this file in development (`pnpm dev:api`). Copy it to .env.
PORT=3399
# Postgres as the plugin's role: run `pnpm db:plugin-role frontline` in the core repo.
DATA_URL=postgres://erxes_plugin_frontline:change-me@127.0.0.1:5434/erxes
# Core's address, without /core/v1.
CORE_URL=http://localhost:3400
# The secret after `frontline:` in core's CORE_PLUGIN_KEYS (32+ characters).
PLUGIN_SECRET=change-me-to-the-secret-in-core-plugin-keys
PUBLIC_URL=http://localhost:3399
# Encrypts page tokens, bot tokens and mail passwords: `openssl rand -base64 32`.
SECRETS_KEY=
# The Grandstream UCM API user every PBX is signed in to: a user from the UCM's
# API configuration page. Set both or neither; without them no PBX connects.
# CALL_API_USER=
# CALL_API_PASSWORD=
# The TURN server every softphone relays its audio through behind NAT, and its login:
# turn.example.com:3478 (turn: is added) or turns:turn.example.com:5349.
# TURN_SERVER_URL=
# TURN_SERVER_USERNAME=
# TURN_SERVER_CREDENTIAL=
# `pnpm dev:ui` serves the remote here; in the image the API serves it at /ui.
UI_ENTRY_URL=http://localhost:3099/remoteEntry.js
# web's origin for help center CORS.
CORE_UI_URL=http://localhost:3500
# Lets a PBX, IMAP or SMTP host or a previewed link be a private or loopback address,
# such as a mail server running beside the API. Never in production.
# OUTBOUND_ALLOW_PRIVATE=true
# Traces go to an OTLP collector when this is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
